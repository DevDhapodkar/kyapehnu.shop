# Firebase web config for the Kya Pehnu? app.
#
# Copy this file to `.env` and paste the values from your Firebase project:
#   Firebase console → Project settings → General → "Your apps" → Web app → SDK setup.
#
# These EXPO_PUBLIC_* vars are inlined into the JS bundle at build time (that is
# what the EXPO_PUBLIC_ prefix means), so treat them as public. A Firebase web
# config is a project *identifier*, not a secret — access is enforced by
# Firebase Authentication and Firestore Security Rules, never by hiding these.
#
# Alternatively, set the same values under expo.extra.firebase in app.json.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Base URL of the Express backend (optional — defaults to http://localhost:5001).
# The app is fully usable on Firebase alone; this only enables the MongoDB
# backend features (vendor orders, catalog, logistics).
# EXPO_PUBLIC_API_BASE_URL=http://localhost:5001
