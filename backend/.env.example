# 5000 is taken on macOS by AirPlay Receiver (ControlCenter answers there as
# "AirTunes" and returns 403), so the default is 5001. Change it freely — just
# keep customer-app/app.json's expo.extra.apiBaseUrl pointing at the same port.
PORT=5001

# MongoDB Atlas
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/kyapehnu

# Firebase Admin (service account). Missing creds disable customer/vendor auth
# (protected routes answer 503) but do NOT stop the server from booting.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Admin panel auth (separate trust domain from Firebase). ADMIN_JWT_SECRET signs
# admin session tokens — use a long random string. ADMIN_EMAIL + ADMIN_PASSWORD
# bootstrap the first admin account once, idempotently, on boot.
ADMIN_JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# Cloudinary (product image storage + CDN). Either set CLOUDINARY_URL alone, OR
# the three discrete vars below. Missing creds just disable uploads (503) —
# they do not stop the server from booting. Free tier: 25 GB storage + bandwidth.
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# WhatsApp Cloud API (Meta). META_APP_SECRET is the Meta app secret used to
# verify the X-Hub-Signature-256 on inbound webhooks; without it the webhook
# refuses every delivery (503) rather than trusting unsigned POSTs.
META_PHONE_NUMBER_ID=
META_WHATSAPP_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=

# Porter API
PORTER_API_KEY=

# CORS — comma-separated list of browser origins allowed to call this API
# cross-origin (e.g. the web storefront). Leave empty to allow only same-origin
# and non-browser clients (the native app sends no Origin and is unaffected).
# Example: CORS_ALLOWED_ORIGINS=https://kyapehnu.shop,https://www.kyapehnu.shop
CORS_ALLOWED_ORIGINS=
