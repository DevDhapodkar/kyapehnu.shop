# 5000 is taken on macOS by AirPlay Receiver (ControlCenter answers there as
# "AirTunes" and returns 403), so the default is 5001. Change it freely — just
# keep customer-app/app.json's expo.extra.apiBaseUrl pointing at the same port.
PORT=5001

# MongoDB Atlas
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/kyapehnu

# Firebase Admin (service account)
FIREBASE_PROJECT_ID=kyapehnushop
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Admin panel access (/admin). Comma-separated emails that may use the vendor
# review panel, the quickest way to bootstrap the first admin. You can also
# grant it per-account with: npm run admin:set -- --email you@example.com
ADMIN_EMAILS=

# WhatsApp Cloud API (Meta)
META_PHONE_NUMBER_ID=
META_WHATSAPP_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=

# Porter API
PORTER_API_KEY=
