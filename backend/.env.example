# 5000 is taken on macOS by AirPlay Receiver (ControlCenter answers there as
# "AirTunes" and returns 403), so the default is 5001. Change it freely — just
# keep customer-app/app.json's expo.extra.apiBaseUrl pointing at the same port.
PORT=5001

# development | production | test
NODE_ENV=development

# MongoDB Atlas (a replica set — required for order-creation transactions)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/kyapehnu

# Optional: point the integration tests at a real Mongo instead of the
# auto-downloaded in-memory replica set. e.g. mongodb://localhost:27017/kyapehnu-test
# MONGO_TEST_URI=

# Comma-separated browser origins allowed by CORS. Native Expo builds send no
# Origin and are always allowed; this is only for web callers.
CORS_ALLOWLIST=

# --- Admin portal (server-rendered back-office) -----------------------------
# Secret used to sign admin session cookies. REQUIRED in production.
ADMIN_JWT_SECRET=
ADMIN_SESSION_HOURS=12
# Used once by `npm run seed:admin` to create the first admin, then unset.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Ops
ADMIN_ROLE=SUPER_ADMIN

# --- Firebase Admin (customer/vendor auth) ----------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Feature flags (deferred until company registration completes) ----------
# Online payment gateway. false ⇒ Cash on Delivery only.
PAYMENTS_ENABLED=false
# Porter driver dispatch. false ⇒ orders wait at READY_FOR_PICKUP for manual
# dispatch. Requires PORTER_API_KEY when true.
PORTER_ENABLED=false
# Vendor WhatsApp alerts. Requires META_* below when true.
WHATSAPP_ENABLED=false

# --- WhatsApp Cloud API (Meta) ----------------------------------------------
META_PHONE_NUMBER_ID=
META_WHATSAPP_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=
# App secret for X-Hub-Signature-256 webhook HMAC verification.
META_APP_SECRET=

# --- Porter API -------------------------------------------------------------
PORTER_API_KEY=
# Override the gateway; defaults to the UAT gateway. Set the prod URL once live.
PORTER_API_BASE=https://pfe-apigw-uat.porter.in/v1

# --- Image storage (Cloudinary — free, no card required) --------------------
# Sign up at cloudinary.com, then copy these from the dashboard. Image uploads
# turn on automatically once all three are present. The api_secret stays on the
# server (signed direct-upload); it is never sent to the app.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional root folder for all uploads (default: kyapehnu).
CLOUDINARY_FOLDER=kyapehnu
