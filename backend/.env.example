# 5000 is taken on macOS by AirPlay Receiver (ControlCenter answers there as
# "AirTunes" and returns 403), so the default is 5001. Change it freely — just
# keep customer-app/app.json's expo.extra.apiBaseUrl pointing at the same port.
PORT=5001

# MongoDB Atlas
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/kyapehnu

# Firebase Admin (service account)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Cloudinary (product image storage + CDN). Either set CLOUDINARY_URL alone, OR
# the three discrete vars below. Missing creds just disable uploads (503) —
# they do not stop the server from booting. Free tier: 25 GB storage + bandwidth.
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# WhatsApp Cloud API (Meta)
META_PHONE_NUMBER_ID=
META_WHATSAPP_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=

# Porter API
PORTER_API_KEY=
